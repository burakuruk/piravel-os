# Piravel OS — ortam değişkenleri
# Kopyala: cp .env.example .env

# ── Uygulama runtime bağlantısı (KISITLI rol) ──
# piravel_app: iş tablolarında tam DML; audit_logs'ta yalnız INSERT + SELECT.
DATABASE_URL=postgres://piravel_app:piravel_app@localhost:5432/piravel_os

# ── Migration / rol kurulumu bağlantısı (OWNER) ──
# Yalnız `npm run db:migrate` ve `npm run db:roles` kullanır. Runtime kullanmaz.
DATABASE_ADMIN_URL=postgres://piravel:piravel@localhost:5432/piravel_os

# piravel_app rolünün parolası (db:roles bunu uygular)
# Üretimde güçlü bir değerle değiştirilir; 8-128 karakter, tırnak/boşluk içermez.
APP_DB_PASSWORD=piravel_app

# ── Better Auth ──
# Oturum imzalama sırrı. Kodda VARSAYILANI YOKTUR: eksik, 32 bayttan kısa veya
# aşağıdaki placeholder ise uygulama BAŞLAMAZ (src/lib/env.ts). Bu dosyadaki
# değeri olduğu gibi kopyalamayın — repoyu okuyan herkes onu bilir.
# Üretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Aynı değer hesap kilidi kayıtlarının hash pepper'ıdır; döndürülürse açık
# oturumlar düşer ve mevcut kilit sayaçları eşleşmez (beklenen davranış).
BETTER_AUTH_SECRET=degistirin
BETTER_AUTH_URL=http://localhost:3000

# Ek güvenilir origin'ler (virgülle ayrılmış) — ters proxy arkasında gerekir.
# Boş bırakılırsa yalnız BETTER_AUTH_URL güvenilir.
# BETTER_AUTH_TRUSTED_ORIGINS=

# İlk yöneticiyi oluştururken kullanılır (npm run seed:admin).
# Verilmezse rastgele parola üretilir ve bir kez ekrana yazılır.
# ADMIN_PASSWORD=

# ── Davet token'ları ──
# Davet token'larının HMAC pepper'ı. BETTER_AUTH_SECRET'ten AYRIDIR ve ona
# fallback YAPMAZ: davet sırrı ile oturum sırrı ayrı tutulur, biri sızarsa
# diğeri düşmez. Eksik veya 32 bayttan kısaysa uygulama başlamaz.
# Üretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ⚠ ROTASYON: pepper değişince mevcut bekleyen davetler doğrulanamaz hâle
# gelir. Sıra: (1) tüm pending davetleri revoke et, (2) pepper'ı değiştir,
# (3) kullanıcılara yeni davet üret.
INVITE_TOKEN_PEPPER=degistirin

# ── Ters proxy güveni ──
# Kaç ters proxy'nin `x-forwarded-for` başlığına güvenileceği.
#
# ⚠ Bu başlık İSTEMCİ TARAFINDAN YAZILABİLİR. 0 (varsayılan) proxy başlıklarını
# HİÇ okumaz. Değer verildiğinde zincir SAĞDAN okunur: her ters proxy gördüğü
# eşi listenin sonuna ekler, dolayısıyla sağdan n. eleman saldırganın
# dokunamadığı tek değerdir.
#
# Yanlış ayarlamak hız sınırını ve hesap kilidini işe yaramaz hâle getirir:
# saldırgan her istekte sahte bir adres yazıp temiz bir sayaç alır.
#
# Geliştirme ve CI'da 1'dir; doğrulama script'leri farklı istemcileri
# `x-forwarded-for` ile simüle eder. Üretimde ÖNÜNDEKİ GERÇEK proxy sayısına
# eşit olmalıdır (tek nginx/ALB → 1).
TRUSTED_PROXY_HOPS=1

# ── Uçtan uca test etiketi ──
# Açıkken (yalnız "1") istemcinin `x-test-run-id` başlığı audit satırlarına
# yazılır ve doğrulama script'leri kendi koşularını izole edebilir.
#
# ⚠ ÜRETİMDE ASLA SET EDİLMEZ. Açık bırakılırsa herhangi bir istemci audit
# kayıtlarını kendi seçtiği etiketle işaretleyebilir ve denetim sorgularını
# yanıltabilir. Varsayılan kapalıdır; "true"/"yes" gibi değerler açmaz.
AUDIT_TEST_RUN_ID_ENABLED=1

# Sprint 6'da eklenecek (günlük job)
# CRON_SECRET=
