# Piravel OS — ortam değişkenleri
# Kopyala: cp .env.example .env

# ── Uygulama runtime bağlantısı (KISITLI rol) ──
# piravel_app: iş tablolarında tam DML; audit_logs'ta yalnız INSERT + SELECT.
DATABASE_URL=postgres://piravel_app:piravel_app@localhost:5432/piravel_os

# ── Migration / rol kurulumu bağlantısı (OWNER) ──
# Yalnız `npm run db:migrate` ve `npm run db:roles` kullanır. Runtime kullanmaz.
DATABASE_ADMIN_URL=postgres://piravel:piravel@localhost:5432/piravel_os

# piravel_app rolünün parolası (db:roles bunu uygular)
# Üretimde güçlü bir değerle değiştirilir; 8-128 karakter, tırnak/boşluk içermez.
APP_DB_PASSWORD=piravel_app

# Sprint 1'de eklenecek (Better Auth)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# Sprint 6'da eklenecek (günlük job)
# CRON_SECRET=
